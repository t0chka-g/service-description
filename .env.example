OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Необязательные параметры. Пустое значение означает значение по умолчанию.
# Таймаут одного запроса к модели, секунды.
OPENAI_TIMEOUT_SECONDS=90
# Лимит токенов ответа. Для SEO-карточки хватает 3000-4096; слишком малый лимит обрезает JSON.
OPENAI_MAX_COMPLETION_TOKENS=4096
# Усилие рассуждения для reasoning-моделей: minimal, low, medium, high. Ниже - быстрее и дешевле.
OPENAI_REASONING_EFFORT=low
# Температура. Не задавайте для моделей, которые ее не поддерживают.
# OPENAI_TEMPERATURE=0.3
